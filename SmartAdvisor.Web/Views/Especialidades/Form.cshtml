@model EspecialidadForm
@{
    ViewData["Title"] = Model.Editando ? "Editar especialidad" : "Nueva especialidad";
}

<div class="encabezado"><h1>@ViewData["Title"]</h1></div>

<form method="post" class="tarjeta formulario" asp-action="@(Model.Editando ? "Editar" : "Crear")" asp-route-id="@(Model.Editando ? Model.Id : null)">
    <div asp-validation-summary="ModelOnly" class="aviso mal"></div>
    <div class="rejilla">
        <label>Nombre<input type="text" name="Nombre" value="@Model.Nombre" required /></label>
        <label>Promedio mínimo (0 a 100)<input type="number" name="PromedioMinimo" value="@Fmt.Dec(Model.PromedioMinimo)" min="0" max="100" step="0.1" required /></label>
    </div>
    <label>Descripción<textarea name="Descripcion" rows="2">@Model.Descripcion</textarea></label>
    <fieldset>
        <legend>Áreas clave</legend>
        @foreach (var i in Consultas.Areas)
        {
            <label class="check"><input type="checkbox" name="AreasClave" value="@i" checked="@Model.AreasClave.Contains(i)" /> @i</label>
        }
    </fieldset>
    <fieldset>
        <legend>Materias de la especialidad</legend>
        @foreach (var m in Model.OpcionesMaterias)
        {
            <label class="check"><input type="checkbox" name="MateriasIds" value="@m.Id" checked="@Model.MateriasIds.Contains(m.Id)" /> @m.Clave · @m.Nombre</label>
        }
    </fieldset>
    <fieldset>
        <legend>Certificaciones</legend>
        @foreach (var c in Model.OpcionesCertificaciones)
        {
            <label class="check"><input type="checkbox" name="CertificacionesIds" value="@c.Id" checked="@Model.CertificacionesIds.Contains(c.Id)" /> @c.Nombre</label>
        }
    </fieldset>
    <fieldset>
        <legend>Cursos</legend>
        @foreach (var c in Model.OpcionesCursos)
        {
            <label class="check"><input type="checkbox" name="CursosIds" value="@c.Id" checked="@Model.CursosIds.Contains(c.Id)" /> @c.Nombre</label>
        }
    </fieldset>
    <div class="botonera">
        <button type="submit" class="boton">Guardar</button>
        <a class="boton sec" asp-action="Index">Cancelar</a>
    </div>
</form>
