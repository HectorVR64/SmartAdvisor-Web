{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-academic-advisor/schemas/alumno.schema.json",
  "title": "Alumnos",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "matricula", "nombre", "semestre", "promedio", "intereses", "estatus"],
    "properties": {
      "id": { "type": "string", "pattern": "^ALU-\\d{3}$" },
      "matricula": { "type": "string", "pattern": "^\\d{9}$" },
      "nombre": { "type": "string", "minLength": 3 },
      "semestre": { "type": "integer", "minimum": 1, "maximum": 9 },
      "promedio": { "type": "number", "minimum": 0, "maximum": 100 },
      "intereses": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["IA", "Desarrollo", "Datos", "Redes", "Seguridad"] }
      },
      "estatus": { "enum": ["activo", "inactivo", "egresado"] }
    }
  }
}
