{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-academic-advisor/schemas/regla.schema.json",
  "title": "Reglas de inferencia",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nombre", "condiciones", "conclusion", "peso"],
    "properties": {
      "id": { "type": "string", "pattern": "^REG-\\d{3}$" },
      "nombre": { "type": "string", "minLength": 3 },
      "condiciones": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hecho", "operador", "valor"],
          "properties": {
            "hecho": { "enum": ["Promedio", "Interes", "Aprobada", "EspecialidadRecomendada", "PrerrequisitosCumplidos"] },
            "operador": { "enum": [">=", ">", "<=", "<", "="] },
            "valor": { "type": ["string", "number", "boolean"] }
          }
        }
      },
      "conclusion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "especialidadId"],
        "properties": {
          "tipo": { "enum": ["EspecialidadRecomendada", "SugerirMateria"] },
          "especialidadId": { "type": ["string", "null"], "pattern": "^ESP-[A-Z]{2,3}$" }
        }
      },
      "peso": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
