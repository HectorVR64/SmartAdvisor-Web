{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-academic-advisor/schemas/especialidad.schema.json",
  "title": "Especialidades",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nombre", "descripcion", "promedioMinimo", "areasClave", "materiasIds", "certificacionesIds", "cursosIds"],
    "properties": {
      "id": { "type": "string", "pattern": "^ESP-[A-Z]{2,3}$" },
      "nombre": { "type": "string", "minLength": 3 },
      "descripcion": { "type": "string" },
      "promedioMinimo": { "type": "number", "minimum": 0, "maximum": 100 },
      "areasClave": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["IA", "Desarrollo", "Datos", "Redes", "Seguridad"] }
      },
      "materiasIds": { "type": "array", "items": { "type": "string", "pattern": "^MAT-\\d{3}$" } },
      "certificacionesIds": { "type": "array", "items": { "type": "string", "pattern": "^CER-\\d{3}$" } },
      "cursosIds": { "type": "array", "items": { "type": "string", "pattern": "^CUR-\\d{3}$" } }
    }
  }
}
